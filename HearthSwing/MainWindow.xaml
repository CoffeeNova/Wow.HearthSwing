<Window
  x:Class="HearthSwing.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:templates="clr-namespace:HearthSwing.Models.Templates"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="HearthSwing"
  Icon="pack://application:,,,/app.ico"
  Height="640"
  Width="420"
  MinHeight="580"
  MinWidth="380"
  Background="#1a1a2e"
  ResizeMode="CanResizeWithGrip"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <!-- Accent colors -->
    <SolidColorBrush x:Key="DonkyBrush" Color="#4a9eff" />
    <SolidColorBrush x:Key="TanyaBrush" Color="#e84393" />
    <SolidColorBrush x:Key="PanelBg" Color="#16213e" />
    <SolidColorBrush x:Key="CardBg" Color="#0f3460" />
    <SolidColorBrush x:Key="TextPrimary" Color="#e0e0e0" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8899aa" />
    <SolidColorBrush x:Key="LaunchGreen" Color="#00b894" />
    <SolidColorBrush x:Key="WarningOrange" Color="#fdcb6e" />

    <!-- Dark scrollbar thumb -->
    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="thumbBorder" Background="#44ffffff" CornerRadius="3" Margin="1" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="#66ffffff" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="#88ffffff" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark vertical scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource DarkScrollThumb}" />
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="8" />
          <Setter Property="MinHeight" Value="8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Profile button style -->
    <Style x:Key="ProfileBtn" TargetType="Button">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Action button style -->
    <Style x:Key="ActionBtn" TargetType="Button">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="bd"
              Background="{TemplateBinding Background}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Link button style -->
    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock
              x:Name="tb"
              Text="{TemplateBinding Content}"
              Foreground="{TemplateBinding Foreground}"
              TextDecorations="Underline"
              Padding="{TemplateBinding Padding}"
            />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="tb"
                  Property="Foreground"
                  Value="{StaticResource TextPrimary}"
                />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented filter button style -->
    <Style x:Key="SegmentBtn" TargetType="Button">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="bd"
              Background="{TemplateBinding Background}"
              CornerRadius="5"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- 0: Title -->
      <RowDefinition Height="*" />
      <!-- 1: Main surface (fills) -->
      <RowDefinition Height="Auto" />
      <!-- 2 -->
      <RowDefinition Height="Auto" />
      <!-- 3 -->
      <RowDefinition Height="Auto" />
      <!-- 4 -->
      <RowDefinition Height="Auto" />
      <!-- 5 -->
      <RowDefinition Height="110" />
      <!-- 6: Log -->
      <RowDefinition Height="Auto" />
      <!-- 7: Status bar -->
      <RowDefinition Height="Auto" />
      <!-- 8: Settings link -->
    </Grid.RowDefinitions>

    <!-- Title and mode switch -->
    <StackPanel Grid.Row="0" Margin="0,0,0,4">
      <TextBlock
        Text="HearthSwing"
        FontSize="22"
        FontWeight="Bold"
        Foreground="{StaticResource TextPrimary}"
        HorizontalAlignment="Center"
      />
      <Border
        Background="{StaticResource CardBg}"
        CornerRadius="6"
        Padding="3"
        Margin="0,10,0,0"
      >
        <UniformGrid Rows="1" Columns="2">
          <Button Content="Templates" Command="{Binding ShowTemplatesModeCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTemplatesMode}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DonkyBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="History" Command="{Binding ShowHistoryModeCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DonkyBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </UniformGrid>
      </Border>
    </StackPanel>

    <!-- Templates panel (row 1-5, templates mode) -->
    <Border
      Grid.Row="1"
      Grid.RowSpan="5"
      Background="{StaticResource PanelBg}"
      CornerRadius="8"
      Padding="12"
      Margin="0,4,0,0"
      Visibility="{Binding IsTemplatesMode, Converter={StaticResource BoolToVis}}"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock
            Text="Templates"
            Foreground="{StaticResource TextPrimary}"
            FontSize="14"
            FontWeight="SemiBold"
          />
          <TextBlock
            Foreground="{StaticResource TextSecondary}"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,2,0,0"
          >
            A template is a saved copy of a character's or account's WTF settings
            (macros, keybindings, Edit Mode layout, addon SavedVariables, client config).
            Capture it from a live character or account, then apply it to any target to
            copy those settings over. A history snapshot is always taken before an apply,
            so changes remain recoverable.
          </TextBlock>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,10,0,6">
          <Button
            Content="&#x1F680; Launch WoW"
            Style="{StaticResource ActionBtn}"
            Background="{StaticResource LaunchGreen}"
            Command="{Binding LaunchWowCommand}"
            Margin="0,0,4,4"
            MinWidth="130"
          />
          <Button
            Content="&#x1F504; Restore Cache"
            Style="{StaticResource ActionBtn}"
            Background="#6c5ce7"
            Command="{Binding ForceRestoreCommand}"
            Visibility="{Binding IsWowRunning, Converter={StaticResource BoolToVis}}"
            ToolTip="Restore protected cache files from memory, then type /reload in WoW."
            Margin="0,0,4,4"
            MinWidth="130"
          />
          <Button
            Content="&#x1F513; Unlock"
            Style="{StaticResource ActionBtn}"
            Background="{StaticResource WarningOrange}"
            Foreground="#2d3436"
            Command="{Binding ForceUnlockCommand}"
            Visibility="{Binding IsCacheLocked, Converter={StaticResource BoolToVis}}"
            Margin="0,0,4,4"
            MinWidth="90"
          />
          <Button
            Content="&#x2795; New Template"
            Style="{StaticResource ActionBtn}"
            Background="{StaticResource DonkyBrush}"
            Command="{Binding OpenCreateTemplateCommand}"
            Margin="0,0,0,4"
            MinWidth="150"
          />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Templates}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Style.Triggers>
                  <Trigger Property="HasItems" Value="False">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate>
                          <TextBlock
                            Text="No templates yet. Create one from a live character or account."
                            Foreground="{StaticResource TextSecondary}"
                            FontSize="12"
                            Margin="0,4"
                          />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Background="{StaticResource CardBg}"
                  CornerRadius="6"
                  Padding="10,8"
                  Margin="0,0,0,6"
                >
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border
                        Background="{StaticResource PanelBg}"
                        CornerRadius="3"
                        Padding="5,1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                      >
                        <TextBlock
                          Text="{Binding KindLabel}"
                          Foreground="{StaticResource DonkyBrush}"
                          FontSize="10"
                          FontWeight="SemiBold"
                        />
                      </Border>
                      <TextBlock
                        Text="{Binding Name}"
                        Foreground="{StaticResource TextPrimary}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>
                    <TextBlock
                      Foreground="{StaticResource TextSecondary}"
                      FontSize="10"
                      TextWrapping="Wrap"
                      Margin="0,2,0,6"
                    >
                      <Run Text="from " />
                      <Run Text="{Binding SourceDescription, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel>
                      <Button
                        Content="Apply"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource LaunchGreen}"
                        Command="{Binding DataContext.OpenApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        Padding="10,3"
                        Margin="0,0,4,0"
                        FontSize="11"
                      />
                      <Button
                        Content="Update"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource DonkyBrush}"
                        Command="{Binding DataContext.OpenUpdateTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        ToolTip="Re-capture this template from a live character or account. A history snapshot is saved first."
                        Padding="10,3"
                        Margin="0,0,4,0"
                        FontSize="11"
                      />
                      <Button
                        Content="History"
                        Style="{StaticResource ActionBtn}"
                        Background="#6c5ce7"
                        Command="{Binding DataContext.ToggleTemplateHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        Padding="10,3"
                        Margin="0,0,4,0"
                        FontSize="11"
                      />
                      <Button
                        Content="Rename"
                        Style="{StaticResource ActionBtn}"
                        Background="{StaticResource TextSecondary}"
                        Command="{Binding DataContext.OpenRenameTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        Padding="10,3"
                        Margin="0,0,4,0"
                        FontSize="11"
                      />
                      <Button
                        Content="Delete"
                        Style="{StaticResource ActionBtn}"
                        Background="#e17055"
                        Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        Padding="10,3"
                        FontSize="11"
                      />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- History panel -->
    <Border
      Grid.Row="1"
      Grid.RowSpan="5"
      Background="{StaticResource PanelBg}"
      CornerRadius="8"
      Padding="12"
      Margin="0,4,0,0"
      Visibility="{Binding IsHistoryMode, Converter={StaticResource BoolToVis}}"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock
            Text="History"
            Foreground="{StaticResource TextPrimary}"
            FontSize="14"
            FontWeight="SemiBold"
          />
          <TextBlock
            Text="History points are created automatically before templates overwrite live WTF targets. Restore works only while WoW is closed."
            Foreground="{StaticResource TextSecondary}"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,2,0,10"
          />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding HistoryGroups}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Style.Triggers>
                  <Trigger Property="HasItems" Value="False">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate>
                          <TextBlock
                            Text="History is empty. It fills automatically when templates are applied."
                            Foreground="{StaticResource TextSecondary}"
                            FontSize="12"
                            Margin="0,4"
                          />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Background="{StaticResource CardBg}"
                  CornerRadius="6"
                  Padding="10,8"
                  Margin="0,0,0,8"
                >
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border
                        Background="{StaticResource PanelBg}"
                        CornerRadius="3"
                        Padding="5,1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                      >
                        <TextBlock
                          Text="{Binding KindLabel}"
                          Foreground="{StaticResource DonkyBrush}"
                          FontSize="10"
                          FontWeight="SemiBold"
                        />
                      </Border>
                      <TextBlock
                        Text="{Binding Title}"
                        Foreground="{StaticResource TextPrimary}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>
                    <TextBlock
                      Text="{Binding Subtitle}"
                      Foreground="{StaticResource TextSecondary}"
                      FontSize="10"
                      TextWrapping="Wrap"
                      Margin="0,2,0,8"
                    />

                    <ItemsControl ItemsSource="{Binding Entries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                            Background="{StaticResource PanelBg}"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,0,4"
                          >
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock
                                  Text="{Binding DisplayName}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                />
                                <TextBlock
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="11"
                                  TextWrapping="Wrap"
                                >
                                  <Run Text="{Binding Description}" />
                                  <Run Text=" | " />
                                  <Run Text="{Binding SizeBytes, StringFormat={}{0:N0} bytes}" />
                                </TextBlock>
                              </StackPanel>
                              <Button
                                Grid.Column="1"
                                Content="Restore"
                                Style="{StaticResource ActionBtn}"
                                Background="{StaticResource LaunchGreen}"
                                Command="{Binding DataContext.RestoreHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,3"
                                Margin="4,0"
                                FontSize="11"
                              />
                              <Button
                                Grid.Column="2"
                                Content="Delete"
                                Style="{StaticResource ActionBtn}"
                                Background="#e17055"
                                Command="{Binding DataContext.DeleteHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,3"
                                FontSize="11"
                              />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Log area -->
    <Border
      Grid.Row="6"
      Background="{StaticResource PanelBg}"
      CornerRadius="6"
      Margin="0,8"
      Padding="8"
    >
      <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
        <TextBlock
          Text="{Binding LogText}"
          Foreground="{StaticResource TextSecondary}"
          FontFamily="Consolas"
          FontSize="11"
          TextWrapping="Wrap"
        />
      </ScrollViewer>
    </Border>

    <!-- Status bar -->
    <Border
      Grid.Row="7"
      Background="{StaticResource CardBg}"
      CornerRadius="4"
      Padding="8,4"
      Margin="0,2"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Grid.Column="0"
          Text="{Binding StatusText}"
          Foreground="{StaticResource TextSecondary}"
          FontSize="11"
          VerticalAlignment="Center"
        />
        <TextBlock
          Grid.Column="1"
          Text="&#x1F512;"
          FontSize="14"
          VerticalAlignment="Center"
          Margin="6,0"
          Visibility="{Binding IsCacheLocked, Converter={StaticResource BoolToVis}}"
          ToolTip="Cache files are locked (read-only)"
        />
        <TextBlock
          Grid.Column="2"
          Text="&#x1F7E2;"
          FontSize="14"
          VerticalAlignment="Center"
          Margin="6,0"
          Visibility="{Binding IsWowRunning, Converter={StaticResource BoolToVis}}"
          ToolTip="WoW is running"
        />
      </Grid>
    </Border>

    <!-- Toast -->
    <Border
      Grid.Row="7"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Background="#dd0f3460"
      BorderBrush="{StaticResource DonkyBrush}"
      BorderThickness="1"
      CornerRadius="6"
      Padding="10,6"
      Margin="0,-44,0,0"
      Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
    >
      <TextBlock
        Text="{Binding ToastMessage}"
        Foreground="{StaticResource TextPrimary}"
        FontSize="11"
      />
    </Border>

    <!-- Footer links -->
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button
        Content="How to use"
        Style="{StaticResource LinkBtn}"
        Command="{Binding ToggleHowToUseCommand}"
        Margin="0,0,8,0"
      />
      <Button
        Content="About"
        Style="{StaticResource LinkBtn}"
        Command="{Binding ToggleAboutCommand}"
        Margin="0,0,8,0"
      />
      <Button
        Content="Settings"
        Style="{StaticResource LinkBtn}"
        Command="{Binding ToggleSettingsCommand}"
      />
    </StackPanel>

    <!-- Settings panel (overlay) -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="340"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock
            Text="Settings"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />

          <TextBlock
            Text="Game Path:"
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            Margin="0,0,0,2"
          />
          <TextBox
            Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
            FontSize="12"
            Padding="6,4"
            Margin="0,0,0,8"
          />

          <TextBlock
            Text="Profiles Path:"
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            Margin="0,0,0,2"
          />
          <TextBox
            Text="{Binding ProfilesPath, UpdateSourceTrigger=PropertyChanged}"
            FontSize="12"
            Padding="6,4"
            Margin="0,0,0,8"
          />

          <TextBlock
            Text="Unlock Delay (seconds):"
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            Margin="0,0,0,2"
          />
          <TextBox
            Text="{Binding UnlockDelay, UpdateSourceTrigger=PropertyChanged}"
            FontSize="12"
            Padding="6,4"
            Width="80"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
          />

          <StackPanel
            Orientation="Horizontal"
            Margin="0,0,0,8"
          >
            <TextBlock
              Text="Max history entries per target:"
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              VerticalAlignment="Center"
              Margin="0,0,6,0"
            />
            <TextBox
              Text="{Binding MaxHistoryEntriesPerTarget, UpdateSourceTrigger=PropertyChanged}"
              FontSize="12"
              Padding="6,4"
              Width="50"
            />
          </StackPanel>

          <Border
            Background="{StaticResource PanelBg}"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,12"
          >
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock
                  Text="Legacy cleanup"
                  Foreground="{StaticResource TextPrimary}"
                  FontSize="13"
                  FontWeight="SemiBold"
                />
                <TextBlock
                  Text="Remove obsolete pre-history folders and markers from Profiles Path."
                  Foreground="{StaticResource TextSecondary}"
                  FontSize="11"
                  TextWrapping="Wrap"
                  Margin="0,2,12,0"
                />
              </StackPanel>
              <Button
                Grid.Column="1"
                Content="Clean Up"
                Style="{StaticResource ActionBtn}"
                Background="#e17055"
                Command="{Binding CleanupLegacyDataCommand}"
                MinWidth="90"
                Margin="8,0,0,0"
              />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
              Content="Save"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource LaunchGreen}"
              Command="{Binding SaveSettingsCommand}"
              MinWidth="80"
            />
            <Button
              Content="Cancel"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource TextSecondary}"
              Command="{Binding ToggleSettingsCommand}"
              MinWidth="80"
            />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- About overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsAboutVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="300"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock
            Text="About HearthSwing"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />
          <TextBlock
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,0,0,4"
          >
            <Run Text="Version: " />
            <Run Text="{Binding AppVersion, Mode=OneTime}" FontWeight="SemiBold" />
          </TextBlock>
          <TextBlock
            Text="WoW Classic Anniversary templates and WTF history manager"
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,0,0,4"
          />
          <TextBlock
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,0,0,12"
          >
            <Run Text="Author: " />
            <Run Text="CoffeeNova" FontWeight="SemiBold" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
              Content="Check for updates"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource CardBg}"
              Command="{Binding CheckForUpdateCommand}"
              MinWidth="140"
              Margin="0,0,8,0"
            />
            <Button
              Content="Close"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource TextSecondary}"
              Command="{Binding ToggleAboutCommand}"
              MinWidth="80"
            />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- How to use overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsHowToUseVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Text="How to Use"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
            <TextBlock
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              TextWrapping="Wrap"
              LineHeight="20"
              xml:space="preserve"
              Visibility="{Binding IsTemplatesMode, Converter={StaticResource BoolToVis}}"
            ><Run
                FontWeight="SemiBold"
                Text="Templates"
              />
Templates are the only transfer workflow. They come in two types: Character templates and Account templates.

<Run
                FontWeight="SemiBold"
                Text="1. Character template"
              />
Click "Create Template", choose "Character", pick a donor character from the account/realm/character tree (use the search box to filter), give it a name, and Create. HearthSwing depersonalizes it, replacing the donor character and realm names with tokens so it can be reused anywhere.

<Run
                FontWeight="SemiBold"
                Text="2. Account template"
              />
Choose "Account" instead to capture only the shared account-level settings (account SavedVariables and account root files). Account templates are applied to a whole account and overwrite settings shared by every character on that account.

<Run
                FontWeight="SemiBold"
                Text="3. Apply a template"
              />
Click "Apply" on a template card. Character templates ask for a target character (tree + search); account templates ask for a target account. Before HearthSwing overwrites live WTF content, it creates history snapshots automatically.

<Run
                FontWeight="SemiBold"
                Text="4. Launch WoW and cache protection"
              />
The Launch WoW button locks cache files as read-only to stop server sync from overwriting your local settings. Use Unlock to release early.

<Run
                FontWeight="SemiBold"
                Text="5. History"
              />
Each template keeps its own revision history from the "History" button on its card. Rename or Delete a template from its card.

<Run
                FontWeight="SemiBold"
                Text="Note:"
              />
Action bars are NOT transferred by templates. Use the ActionBarSaver addon to save/restore action bars separately.</TextBlock
            >
            <TextBlock
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              TextWrapping="Wrap"
              LineHeight="20"
              xml:space="preserve"
              Visibility="{Binding IsHistoryMode, Converter={StaticResource BoolToVis}}"
            ><Run
                FontWeight="SemiBold"
                Text="History"
              />
History is filled automatically when a template is applied and HearthSwing is about to overwrite live WTF content.

<Run
                FontWeight="SemiBold"
                Text="1. What is stored"
              />
Each history group represents one live target: either a character subtree or shared account settings.

<Run
                FontWeight="SemiBold"
                Text="2. Restore"
              />
Close WoW first, then press "Restore" on the history entry you want. HearthSwing snapshots the current state again before restoring, so the rollback itself is also recoverable.

<Run
                FontWeight="SemiBold"
                Text="3. Cleanup"
              />
Delete old history entries manually when you no longer need them, or rely on the configured per-target history limit.</TextBlock
            >
            </StackPanel>
          </ScrollViewer>
          <Button
            Grid.Row="2"
            Content="Close"
            Style="{StaticResource ActionBtn}"
            Background="{StaticResource TextSecondary}"
            Command="{Binding ToggleHowToUseCommand}"
            HorizontalAlignment="Right"
            MinWidth="80"
          />
        </Grid>
      </Border>
    </Border>

    <!-- Archiving in progress overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsArchiving, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="320"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock
            Text="{Binding ArchivingTitle}"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,8"
          />
          <TextBlock
            Text="{Binding ArchivingDetailText}"
            Foreground="{StaticResource TextSecondary}"
            FontSize="13"
            TextWrapping="Wrap"
          />
          <ProgressBar
            IsIndeterminate="True"
            Height="4"
            Margin="0,12,0,0"
            Width="220"
          />
        </StackPanel>
      </Border>
    </Border>

    <!-- Create template (donor selection) overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsTemplateCreateVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="360"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Text="{Binding TemplateCreateTitle}"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />

          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock
              Text="Template type:"
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              Margin="0,0,0,4"
              Visibility="{Binding IsCreatingNewTemplate, Converter={StaticResource BoolToVis}}"
            />
            <StackPanel
              Orientation="Horizontal"
              Margin="0,0,0,8"
              Visibility="{Binding IsCreatingNewTemplate, Converter={StaticResource BoolToVis}}"
            >
              <Button
                Content="Character"
                Command="{Binding SetCreateKindCharacterCommand}"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource DonkyBrush}"
                BorderThickness="1"
                Padding="12,5"
                Margin="0,0,6,0"
                MinWidth="90"
              >
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCreatingCharacterTemplate}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button
                Content="Account"
                Command="{Binding SetCreateKindAccountCommand}"
                Background="{StaticResource CardBg}"
                Padding="12,5"
                MinWidth="90"
              >
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCreatingAccountTemplate}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>
            <TextBlock
              Text="Template name:"
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              Margin="0,0,0,4"
            />
            <TextBox
              Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}"
              FontSize="13"
              Padding="4,3"
              IsEnabled="{Binding IsCreatingNewTemplate}"
            />
            <TextBox
              Text="{Binding DonorSearchText, UpdateSourceTrigger=PropertyChanged}"
              FontSize="12"
              Padding="4,3"
              Margin="0,10,0,0"
              ToolTip="Search"
            />
          </StackPanel>

          <Grid Grid.Row="2">
            <TreeView
              x:Name="DonorTreeView"
              ItemsSource="{Binding DonorCharacterTree}"
              SelectedItemChanged="OnDonorTreeSelectedItemChanged"
              Background="{StaticResource PanelBg}"
              Foreground="{StaticResource TextPrimary}"
              BorderThickness="0"
              MaxHeight="240"
              Visibility="{Binding IsCreatingCharacterTemplate, Converter={StaticResource BoolToVis}}"
            >
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                  <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock
                    Text="{Binding Label}"
                    Foreground="{StaticResource TextPrimary}"
                    FontSize="12"
                  />
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <ListBox
              ItemsSource="{Binding DonorAccounts}"
              SelectedItem="{Binding SelectedDonorAccount}"
              Background="{StaticResource PanelBg}"
              Foreground="{StaticResource TextPrimary}"
              BorderThickness="0"
              MaxHeight="240"
              Visibility="{Binding IsCreatingAccountTemplate, Converter={StaticResource BoolToVis}}"
            >
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding AccountName}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimary}"
                  />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
              Content="Create"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource LaunchGreen}"
              Command="{Binding ConfirmCreateTemplateCommand}"
              IsEnabled="{Binding CanConfirmCreateTemplate}"
              Visibility="{Binding IsCreatingNewTemplate, Converter={StaticResource BoolToVis}}"
              MinWidth="80"
              Margin="0,0,8,0"
            />
            <Button
              Content="Update"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource LaunchGreen}"
              Command="{Binding ConfirmUpdateTemplateCommand}"
              IsEnabled="{Binding CanConfirmCreateTemplate}"
              Visibility="{Binding IsUpdatingTemplate, Converter={StaticResource BoolToVis}}"
              MinWidth="80"
              Margin="0,0,8,0"
            />
            <Button
              Content="Cancel"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource TextSecondary}"
              Command="{Binding CancelCreateTemplateCommand}"
              MinWidth="80"
            />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- Apply template (target selection) overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsTemplateApplyVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="360"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Text="{Binding TemplateApplyTitle}"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />

          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              Margin="0,0,0,4"
            >
              <Run Text="Find target " />
              <Run Text="{Binding TemplateToApply.KindLabel, Mode=OneWay, FallbackValue=item}" />
              <Run Text=" (optional):" />
            </TextBlock>
            <TextBox
              Text="{Binding TargetSearchText, UpdateSourceTrigger=PropertyChanged}"
              FontSize="12"
              Padding="4,3"
              ToolTip="Optional filter. Select the target in the list below."
            />
          </StackPanel>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock
              Text="Restore scope:"
              Foreground="{StaticResource TextSecondary}"
              FontSize="12"
              VerticalAlignment="Center"
              Margin="0,0,8,0"
            />
            <ComboBox
              Width="180"
              SelectedValuePath="Tag"
              SelectedValue="{Binding TemplateRestoreScope, Mode=TwoWay}"
              FontSize="12"
            >
              <ComboBoxItem Content="Full" Tag="{x:Static templates:TemplateApplyScope.Full}" />
              <ComboBoxItem Content="Cache only" Tag="{x:Static templates:TemplateApplyScope.CacheOnly}" />
            </ComboBox>
          </StackPanel>

          <TextBlock
            Grid.Row="3"
            Text="A history snapshot is always created before apply to live WTF."
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,0,0,8"
          />

          <CheckBox
            Grid.Row="4"
            IsChecked="{Binding IncludeAccountScopedCharacterSettings}"
            Foreground="{StaticResource TextSecondary}"
            FontSize="12"
            Margin="0,0,0,8"
            Visibility="{Binding IsApplyingCharacterTemplate, Converter={StaticResource BoolToVis}}"
          >
            <TextBlock Text="Full transfer (include account shared settings from Shared/)" TextWrapping="Wrap" />
          </CheckBox>

          <Grid Grid.Row="5">
            <TreeView
              x:Name="TargetTreeView"
              ItemsSource="{Binding TargetCharacterTree}"
              SelectedItemChanged="OnTargetTreeSelectedItemChanged"
              Background="{StaticResource PanelBg}"
              Foreground="{StaticResource TextPrimary}"
              BorderThickness="0"
              MaxHeight="240"
              Visibility="{Binding IsApplyingCharacterTemplate, Converter={StaticResource BoolToVis}}"
            >
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                  <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock
                    Text="{Binding Label}"
                    Foreground="{StaticResource TextPrimary}"
                    FontSize="12"
                  />
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <ListBox
              ItemsSource="{Binding TargetAccounts}"
              SelectedItem="{Binding SelectedTargetAccount}"
              Background="{StaticResource PanelBg}"
              Foreground="{StaticResource TextPrimary}"
              BorderThickness="0"
              MaxHeight="240"
              Visibility="{Binding IsApplyingAccountTemplate, Converter={StaticResource BoolToVis}}"
            >
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding AccountName}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimary}"
                  />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
              Content="Apply"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource LaunchGreen}"
              Command="{Binding ConfirmApplyTemplateCommand}"
              IsEnabled="{Binding CanConfirmApplyTemplate}"
              MinWidth="80"
              Margin="0,0,8,0"
            />
            <Button
              Content="Cancel"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource TextSecondary}"
              Command="{Binding CancelApplyTemplateCommand}"
              MinWidth="80"
            />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- Rename template overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsTemplateRenameVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="320"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock
            Text="Rename Template"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />
          <TextBox
            Text="{Binding RenameTemplateName, UpdateSourceTrigger=PropertyChanged}"
            FontSize="13"
            Padding="4,3"
          />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
              Content="Rename"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource LaunchGreen}"
              Command="{Binding ConfirmRenameTemplateCommand}"
              IsEnabled="{Binding CanConfirmRenameTemplate}"
              MinWidth="80"
              Margin="0,0,8,0"
            />
            <Button
              Content="Cancel"
              Style="{StaticResource ActionBtn}"
              Background="{StaticResource TextSecondary}"
              Command="{Binding CancelRenameTemplateCommand}"
              MinWidth="80"
            />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Template history overlay -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="9"
      Background="#ee1a1a2e"
      CornerRadius="8"
      Visibility="{Binding IsTemplateHistoryVisible, Converter={StaticResource BoolToVis}}"
      Padding="20"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      MinWidth="360"
    >
      <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Text="{Binding TemplateHistoryTitle}"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,4"
          />
          <TextBlock
            Grid.Row="0"
            Text="{Binding TemplateHistorySubtitle}"
            Foreground="{StaticResource TextSecondary}"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,24,0,12"
          />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding TemplateHistoryEntries}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Style.Triggers>
                      <Trigger Property="HasItems" Value="False">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate>
                              <TextBlock
                                Text="No template history yet."
                                Foreground="{StaticResource TextSecondary}"
                                FontSize="12"
                                Margin="0,4"
                              />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Background="{StaticResource PanelBg}"
                      CornerRadius="4"
                      Padding="8,6"
                      Margin="0,0,0,4"
                    >
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                          <TextBlock
                            Text="{Binding DisplayName}"
                            Foreground="{StaticResource TextPrimary}"
                            FontSize="12"
                            FontWeight="SemiBold"
                          />
                          <TextBlock
                            Foreground="{StaticResource TextSecondary}"
                            FontSize="11"
                            TextWrapping="Wrap"
                          >
                            <Run Text="{Binding Description}" />
                            <Run Text=" | " />
                            <Run Text="{Binding SizeBytes, StringFormat={}{0:N0} bytes}" />
                          </TextBlock>
                        </StackPanel>
                        <Button
                          Grid.Column="1"
                          Content="Restore"
                          Style="{StaticResource ActionBtn}"
                          Background="{StaticResource LaunchGreen}"
                          Command="{Binding DataContext.RestoreTemplateHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Padding="8,3"
                          Margin="4,0"
                          FontSize="11"
                        />
                        <Button
                          Grid.Column="2"
                          Content="Delete"
                          Style="{StaticResource ActionBtn}"
                          Background="#e17055"
                          Command="{Binding DataContext.DeleteTemplateHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Padding="8,3"
                          FontSize="11"
                        />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Button
            Grid.Row="2"
            Content="Close"
            Style="{StaticResource ActionBtn}"
            Background="{StaticResource TextSecondary}"
            Command="{Binding CloseTemplateHistoryCommand}"
            HorizontalAlignment="Right"
            MinWidth="80"
            Margin="0,12,0,0"
          />
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
