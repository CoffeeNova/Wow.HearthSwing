            Text="Template Version History"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimary}"
            Margin="0,0,0,12"
          />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding TemplateVersions}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Style.Triggers>
                      <Trigger Property="HasItems" Value="False">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate>
                              <TextBlock
                                Text="No versions saved yet."
                                Foreground="{StaticResource TextSecondary}"
                                FontSize="12"
                                Margin="0,4"
                              />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Background="{StaticResource PanelBg}"
                      CornerRadius="4"
                      Padding="8,6"
                      Margin="0,0,0,4"
                    >
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Text="{Binding DisplayName}"
                          Foreground="{StaticResource TextPrimary}"
                          FontSize="12"
                          VerticalAlignment="Center"
                        />
                        <Button
                          Grid.Column="1"
                          Content="Restore"
                          Style="{StaticResource ActionBtn}"
                          Background="{StaticResource LaunchGreen}"
                          Command="{Binding DataContext.RestoreTemplateVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding VersionId}"
                          Padding="8,3"
                          Margin="4,0"
                          FontSize="11"
                        />
                        <Button
                          Grid.Column="2"
                          Content="Delete"
                          Style="{StaticResource ActionBtn}"
                          Background="#e17055"
                          Command="{Binding DataContext.DeleteTemplateVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding VersionId}"
                          Padding="8,3"
                          FontSize="11"
                        />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Button
            Grid.Row="2"
            Content="Close"
            Style="{StaticResource ActionBtn}"
            Background="{StaticResource TextSecondary}"
            Command="{Binding CloseTemplateVersionHistoryCommand}"
            HorizontalAlignment="Right"
            MinWidth="80"
            Margin="0,12,0,0"
          />
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
